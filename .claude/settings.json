{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(./android/keystore.properties)",
      "Read(./android/app/google-services.json)",
      "Read(**/.migration-*-rollback.json)",
      "Read(**/.vercel/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Edit(./android/keystore.properties)",
      "Edit(./android/app/google-services.json)",
      "Edit(**/.migration-*-rollback.json)",
      "Edit(**/.vercel/**)",
      "Read(**/keystore.properties)",
      "Edit(**/keystore.properties)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/google-services.json)",
      "Edit(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Edit(**/GoogleService-Info.plist)",
      "Read(**/*.p8)",
      "Edit(**/*.p8)",
      "Read(**/*service-account*.json)",
      "Edit(**/*service-account*.json)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Bash(head .env*)",
      "Bash(head *.env*)",
      "Bash(tail .env*)",
      "Bash(tail *.env*)",
      "Bash(less .env*)",
      "Bash(less *.env*)",
      "Bash(cat android/keystore.properties)",
      "Bash(cat android/app/google-services.json)",
      "Bash(cat .migration-*)",
      "Bash(cat *.migration-*)",
      "Bash(head .migration-*)",
      "Bash(head *.migration-*)",
      "Bash(tail .migration-*)",
      "Bash(tail *.migration-*)",
      "Bash(less .migration-*)",
      "Bash(less *.migration-*)",
      "Bash(cat .vercel/*)",
      "Bash(cat *.vercel/*)",
      "Bash(head .vercel/*)",
      "Bash(head *.vercel/*)",
      "Bash(tail .vercel/*)",
      "Bash(tail *.vercel/*)",
      "Bash(less .vercel/*)",
      "Bash(less *.vercel/*)"
    ]
  }
}
